{% extends "base.html" %}
{% block title %}| {{ action }} Player{% endblock %}
{% block content %}

<h1>{% if action == 'Add' %}➕ Add Player{% else %}✏️ Edit Player{% endif %}</h1>

<div class="card">
    <form method="POST">
        <div class="form-row">
            <div class="form-group">
                <label>Player ID *</label>
                <input type="number" name="player_id"
                       value="{{ player[0] if player else '' }}"
                       {% if action == 'Edit' %}readonly{% endif %}
                       required>
            </div>
            <div class="form-group">
                <label>Global Rank</label>
                <input type="number" name="global_rank" min="0"
                       value="{{ player[6] if player else '' }}">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>First Name *</label>
                <input type="text" name="fname" maxlength="50"
                       value="{{ player[1] if player else '' }}" required>
            </div>
            <div class="form-group">
                <label>Last Name *</label>
                <input type="text" name="lname" maxlength="50"
                       value="{{ player[2] if player else '' }}" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Country</label>
                <input type="text" name="country" maxlength="50"
                       value="{{ player[3] if player else '' }}">
            </div>
            <div class="form-group">
                <label>Religion</label>
                <input type="text" name="religion" maxlength="50"
                       value="{{ player[4] if player else '' }}">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Birth Date</label>
                <input type="date" name="birth_date"
                       value="{{ player[5] if player and player[5] else '' }}">
            </div>
            <div class="form-group">
                <label>Status</label>
                <select name="status">
                    <option value="Active"   {% if player and player[7] == 'Active' %}selected{% endif %}>Active</option>
                    <option value="Inactive" {% if player and player[7] == 'Inactive' %}selected{% endif %}>Inactive</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" maxlength="100"
                   value="{{ player[8] if player else '' }}">
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">{{ action }} Player</button>
            <a href="/players" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

{% endblock %}

{% extends "base.html" %}
{% block title %}| Players{% endblock %}
{% block content %}

<div class="top-bar">
    <h1>🎮 Players</h1>
    <a href="/players/add" class="btn btn-primary">+ Add Player</a>
</div>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Country</th>
            <th>Birth Date</th>
            <th>Global Rank</th>
            <th>Status</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for p in players %}
        <tr>
            <td>{{ p[0] }}</td>
            <td><strong>{{ p[1] }} {{ p[2] }}</strong></td>
            <td>{{ p[3] or '—' }}</td>
            <td>{{ p[4] or '—' }}</td>
            <td><span class="badge badge-yellow">#{{ p[5] }}</span></td>
            <td>
                {% if p[6] == 'Active' %}
                    <span class="badge badge-green">Active</span>
                {% else %}
                    <span class="badge badge-red">Inactive</span>
                {% endif %}
            </td>
            <td>{{ p[7] or '—' }}</td>
            <td>
                <a href="/players/edit/{{ p[0] }}" class="btn btn-edit">Edit</a>
                <form method="POST" action="/players/delete/{{ p[0] }}" style="display:inline;"
                      onsubmit="return confirm('Delete {{ p[1] }} {{ p[2] }}?')">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </td>
        </tr>
        {% else %}
        <tr><td colspan="8" style="text-align:center; color:#6b7280;">No players found.</td></tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}

