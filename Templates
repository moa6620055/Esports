{% extends "base.html" %}
{% block title %}| Tournaments{% endblock %}
{% block content %}

<div class="top-bar">
    <h1>🏆 Tournaments</h1>
    <a href="/tournaments/add" class="btn btn-primary">+ Add Tournament</a>
</div>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Game</th>
            <th>Max Teams</th>
            <th>Prize Pool</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for t in tournaments %}
        <tr>
            <td>{{ t[0] }}</td>
            <td><strong>{{ t[1] }}</strong></td>
            <td>{{ t[6] or '—' }}</td>
            <td>{{ t[2] or '—' }}</td>
            <td>${{ "{:,.0f}".format(t[7]) if t[7] else '—' }}</td>
            <td>{{ t[4] or '—' }}</td>
            <td>{{ t[5] or '—' }}</td>
            <td>
                {% if t[3] == 'Open' %}
                    <span class="badge badge-green">Open</span>
                {% elif t[3] == 'Closed' %}
                    <span class="badge badge-red">Closed</span>
                {% elif t[3] == 'Ongoing' %}
                    <span class="badge badge-blue">Ongoing</span>
                {% else %}
                    <span class="badge badge-yellow">{{ t[3] or '—' }}</span>
                {% endif %}
            </td>
            <td>
                <a href="/tournaments/edit/{{ t[0] }}" class="btn btn-edit">Edit</a>
                <form method="POST" action="/tournaments/delete/{{ t[0] }}" style="display:inline;"
                      onsubmit="return confirm('Delete {{ t[1] }}?')">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </td>
        </tr>
        {% else %}
        <tr><td colspan="9" style="text-align:center; color:#6b7280;">No tournaments found.</td></tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>eSports Manager {% block title %}{% endblock %}</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #0f0f1a;
            color: #e0e0f0;
            min-height: 100vh;
        }

        nav {
            background: #1a1a2e;
            border-bottom: 2px solid #7c3aed;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            gap: 2rem;
            height: 56px;
        }

        nav .brand {
            color: #a78bfa;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-decoration: none;
            margin-right: auto;
        }

        nav a {
            color: #c4b5fd;
            text-decoration: none;
            font-size: 0.9rem;
            padding: 6px 14px;
            border-radius: 6px;
            transition: background 0.2s;
        }

        nav a:hover, nav a.active {
            background: #7c3aed;
            color: #fff;
        }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        h1 {
            font-size: 1.6rem;
            color: #a78bfa;
            margin-bottom: 1.5rem;
        }

        /* Flash messages */
        .flash { padding: 10px 16px; border-radius: 6px; margin-bottom: 1rem; font-size: 0.9rem; }
        .flash.success { background: #14532d; color: #86efac; border: 1px solid #166534; }
        .flash.error   { background: #450a0a; color: #fca5a5; border: 1px solid #7f1d1d; }

        /* Table */
        table { width: 100%; border-collapse: collapse; background: #1a1a2e; border-radius: 10px; overflow: hidden; }
        thead { background: #2d1b69; }
        th { padding: 12px 16px; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: #a78bfa; }
        td { padding: 11px 16px; font-size: 0.9rem; border-bottom: 1px solid #2a2a4a; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #1f1f38; }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .badge-green  { background: #14532d; color: #86efac; }
        .badge-red    { background: #450a0a; color: #fca5a5; }
        .badge-yellow { background: #422006; color: #fde68a; }
        .badge-blue   { background: #1e3a5f; color: #93c5fd; }

        /* Buttons */
        .btn {
            display: inline-block;
            padding: 7px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: opacity 0.2s;
        }
        .btn:hover { opacity: 0.85; }
        .btn-primary  { background: #7c3aed; color: #fff; }
        .btn-edit     { background: #1e40af; color: #fff; }
        .btn-danger   { background: #dc2626; color: #fff; }
        .btn-secondary{ background: #374151; color: #d1d5db; }

        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; }

        /* Forms */
        .card {
            background: #1a1a2e;
            border: 1px solid #2d2d4e;
            border-radius: 12px;
            padding: 2rem;
            max-width: 600px;
        }

        .form-group { margin-bottom: 1.2rem; }
        .form-group label { display: block; font-size: 0.85rem; color: #a78bfa; margin-bottom: 5px; }
        .form-group input,
        .form-group select {
            width: 100%;
            padding: 9px 12px;
            background: #0f0f1a;
            border: 1px solid #3d3d6b;
            border-radius: 6px;
            color: #e0e0f0;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .form-group input:focus,
        .form-group select:focus { border-color: #7c3aed; }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

        .form-actions { display: flex; gap: 1rem; margin-top: 1.5rem; }

        /* Security note box */
        .security-note {
            background: #1a2e1a;
            border: 1px solid #166534;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 0.82rem;
            color: #86efac;
            margin-bottom: 1.5rem;
        }
        .security-note strong { color: #4ade80; }
    </style>
</head>
<body>
    <nav>
        <a href="/" class="brand">⚡ eSports Manager</a>
        <a href="/teams"       {% if request.path.startswith('/teams') %}class="active"{% endif %}>Teams</a>
        <a href="/players"     {% if request.path.startswith('/players') %}class="active"{% endif %}>Players</a>
        <a href="/tournaments" {% if request.path.startswith('/tournaments') %}class="active"{% endif %}>Tournaments</a>
        <a href="/matches"     {% if request.path.startswith('/matches') %}class="active"{% endif %}>Matches</a>
    </nav>

    <div class="container">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% for category, message in messages %}
                <div class="flash {{ category }}">{{ message }}</div>
            {% endfor %}
        {% endwith %}

        {% block content %}{% endblock %}
    </div>
</body>
</html>

